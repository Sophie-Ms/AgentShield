# AgentShield Lite Environment Configuration
AGENTSHIELD_API_KEY=agentshield-secret-key-123
HOST=0.0.0.0
PORT=8000

# Database (defaults to SQLite fallback if PostgreSQL is not active)
DATABASE_URL=sqlite+aiosqlite:///agentshield.db
# DATABASE_URL=postgresql+asyncpg://agentshield:shieldpass@localhost:5432/agentshield_db

# LLM Provider ("mock", "openai")
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Vector Store
CHROMA_PERSIST_DIR=./chroma_db
